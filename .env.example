# Provider: openai | anthropic | google | ollama | deepseek | mock
LLM_PROVIDER=openai

# API keys (only the one matching LLM_PROVIDER is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Per-role model map (leave blank/comment out to auto-pick per provider)
# MODEL_RESEARCH=
# MODEL_DRAFT=
# MODEL_VERIFY=

# Embeddings: local | openai | off   ("off" = BM25+synonyms, fastest — no model download)
EMBEDDINGS=off
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Agent loop caps
MAX_CYCLES=2
MAX_RESEARCH_ROUNDS=2

# SQLite persistence path (relative to project root)
DB_PATH=data/cases.db
